<script>
  document.querySelectorAll<HTMLElement>('.route-explorer').forEach(root => {
    const panels = [...root.querySelectorAll<HTMLElement>('.route-panel')];
    const stage = root.querySelector<HTMLElement>('.route-panels')!;
    const counter = root.querySelector<HTMLElement>('.route-counter')!;
    const controls = root.querySelector<HTMLElement>('.route-controls')!;
    const play = root.querySelector<HTMLButtonElement>('[data-route-action="play"]')!;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const ru = root.dataset.lang === 'ru';
    let current = 0, enabled = true, hovered = false, focused = false;
    let pauseUntil = 0, nextDue = performance.now() + 8000;
    let timer: ReturnType<typeof setTimeout> | undefined;
    function schedule() {
      clearTimeout(timer);
      play.textContent = enabled ? (ru ? 'Отключить автосмену' : 'Disable automatic switching') : (ru ? 'Включить автосмену' : 'Enable automatic switching');
      play.setAttribute('aria-pressed', String(!enabled));
      play.disabled = motion.matches;
      const running = enabled && !motion.matches && !hovered && !focused && !document.hidden;
      root.dataset.autoplay = running ? (performance.now() < pauseUntil ? 'cooldown' : 'running') : 'paused';
      if (running) timer = setTimeout(() => select(current + 1, false), Math.max(0, nextDue - performance.now()));
    }
    function resume() {
      nextDue = pauseUntil > performance.now() ? pauseUntil : performance.now() + 8000;
      schedule();
    }
    function select(index: number, manual = true) {
      current = (index + panels.length) % panels.length;
      counter.textContent = `${current + 1} / ${panels.length}`;
      counter.setAttribute('aria-label', ru ? `Сценарий ${current + 1} из ${panels.length}` : `Scenario ${current + 1} of ${panels.length}`);
      if (manual) pauseUntil = performance.now() + 30000;
      nextDue = manual ? pauseUntil : performance.now() + 8000;
      panels.forEach((panel, i) => {
        panel.hidden = i !== current;
        panel.setAttribute('role', 'group');
        panel.setAttribute('aria-label', `${i + 1} / ${panels.length}: ${panel.dataset.title}`);
      });
      schedule();
    }
    root.querySelector('[data-route-action="previous"]')!.addEventListener('click', () => select(current - 1));
    root.querySelector('[data-route-action="next"]')!.addEventListener('click', () => select(current + 1));
    stage.tabIndex = 0;
    stage.addEventListener('keydown', event => {
      if (event.target !== stage) return;
      if (event.key === 'ArrowLeft') { event.preventDefault(); select(current - 1); }
      else if (event.key === 'ArrowRight') { event.preventDefault(); select(current + 1); }
      else if (event.key === 'Home') { event.preventDefault(); select(0); }
      else if (event.key === 'End') { event.preventDefault(); select(panels.length - 1); }
    });
    let gesture: { id: number; x: number; y: number } | null = null;
    let suppressClickUntil = 0;
    stage.addEventListener('pointerdown', event => {
      suppressClickUntil = 0;
      if (event.pointerType !== 'touch' || !event.isPrimary || (event.target as Element).closest('a,button,input,select,textarea')) return;
      gesture = { id: event.pointerId, x: event.clientX, y: event.clientY };
    });
    stage.addEventListener('pointerup', event => {
      if (!gesture || gesture.id !== event.pointerId) return;
      const dx = event.clientX - gesture.x, dy = event.clientY - gesture.y;
      gesture = null;
      if (Math.abs(dx) < 55 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
      select(current + (dx < 0 ? 1 : -1));
      suppressClickUntil = performance.now() + 400;
    });
    stage.addEventListener('pointercancel', () => { gesture = null; });
    stage.addEventListener('click', event => {
      if (performance.now() < suppressClickUntil) { event.preventDefault(); event.stopPropagation(); }
    }, true);
    play.addEventListener('click', () => { enabled = !enabled; resume(); });
    root.addEventListener('mouseenter', () => { hovered = true; schedule(); });
    root.addEventListener('mouseleave', () => { hovered = false; resume(); });
    root.addEventListener('focusin', () => { focused = true; schedule(); });
    root.addEventListener('focusout', event => { focused = root.contains(event.relatedTarget as Node); if (focused) schedule(); else resume(); });
    document.addEventListener('visibilitychange', () => { if (document.hidden) schedule(); else resume(); });
    motion.addEventListener('change', resume);
    root.querySelectorAll<HTMLButtonElement>('.route-arrow').forEach(button => { button.hidden = false; });
    controls.hidden = false;
    select(0, false);
  });
</script>
